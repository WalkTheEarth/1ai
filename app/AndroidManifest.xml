<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.oneai"
    android:versionCode="1"
    android:versionName="1.0">

    <!--
      minSdkVersion 4 (Android 1.6 Donut) is the practical floor, not an
      arbitrary one: android.os.Build.VERSION.SDK_INT (which any code doing
      backwards-compatible branching depends on) was itself only added in
      API 4. Going lower would mean version-checking via Build.VERSION.SDK
      string comparison, which buys nothing.

      targetSdkVersion 28 keeps us clear of Android 14's refusal to install
      APKs targeting below 23, while staying low enough that no modern
      behaviour change (scoped storage, cleartext blocking, notification
      permissions) affects us.
    -->
    <uses-sdk android:minSdkVersion="4" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Only for finding a key file dropped on the device. Capped at API 32
      because from API 33 this permission no longer covers arbitrary documents,
      and the file picker is used there instead. On API 22 and below it is
      granted at install; from 23 it is requested at the moment it is needed.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.ChatsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ChatActivity"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.ImageViewerActivity"
            android:label="@string/attached_to"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

    </application>
</manifest>
