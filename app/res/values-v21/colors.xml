<?xml version="1.0" encoding="utf-8"?>
<!--
  Era 3 palette: Android 5.0+ (Material).

  The first light theme in the set. Material's own light surfaces and the teal
  accent, with dark text on light rows == the opposite of eras 1 and 2, which
  is why text colour is a resource and never a constant.
-->
<resources>
    <color name="bg_window">#fffafafa</color>
    <color name="bg_surface">#ffffffff</color>
    <color name="bg_input">#ffffffff</color>

    <color name="text_primary">#ff212121</color>
    <color name="text_secondary">#ff757575</color>
    <color name="text_on_accent">#ffffffff</color>

    <color name="accent">#ff009688</color>
    <color name="accent_dim">#ff00796b</color>

    <color name="row_focused">#ffb2dfdb</color>
    <color name="row_pressed">#ff80cbc4</color>
    <color name="row_text_focused">#ff00251f</color>
    <color name="msg_focused">#ffe0f2f1</color>

    <color name="divider">#ffe0e0e0</color>

    <color name="title_grad_top">#ff009688</color>
    <color name="title_grad_bottom">#ff009688</color>
    <color name="title_text">#ffffffff</color>
    <color name="title_subtitle">#ccffffff</color>

    <color name="btn_grad_top">#ff009688</color>
    <color name="btn_grad_bottom">#ff00897b</color>
    <color name="btn_stroke">#ff00796b</color>
    <color name="btn_text">#ffffffff</color>

    <color name="bubble_user">#ffe0f2f1</color>
    <color name="bubble_assistant">#ffffffff</color>
    <color name="bubble_error">#ffffebee</color>
</resources>
