<?xml version="1.0" encoding="utf-8"?>
<!--
  Row background for a keyboard-driven list.

  state_focused is listed before state_pressed on purpose: on a BlackBerry the
  trackpad generates focus events constantly and press events briefly, and we
  must never end up in a state where the user cannot see which row they are on.
  The amber block is the pre-Holo selection colour.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/row_focused" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/row_focused" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/row_pressed" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
