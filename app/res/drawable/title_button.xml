<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/row_focused" />
            <corners android:radius="3dip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/row_pressed" />
            <corners android:radius="3dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/btn_grad_top" />
            <corners android:radius="3dip" />
            <stroke android:width="1dip" android:color="@color/btn_stroke" />
        </shape>
    </item>
</selector>
